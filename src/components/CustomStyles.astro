<style is:inline>
  :root {
    --aw-font-sans: 'DM Sans', 'Noto Sans SC', sans-serif;
    --aw-font-serif: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
    --aw-font-heading: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;

    --aw-color-primary: rgb(23 78 143);
    --aw-color-secondary: rgb(144 59 38);
    --aw-color-accent: rgb(23 78 143);

    --aw-color-text-heading: rgb(25 24 20);
    --aw-color-text-default: rgb(47 45 40);
    --aw-color-text-muted: rgb(105 101 93);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-page-dark: rgb(24 25 26);

    ::selection {
      background-color: rgb(226 216 190);
      color: rgb(25 24 20);
    }
  }

  .dark {
    --aw-font-sans: 'DM Sans', 'Noto Sans SC', sans-serif;
    --aw-font-serif: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;
    --aw-font-heading: 'Source Serif 4', 'Noto Serif SC', Georgia, serif;

    --aw-color-primary: rgb(137 177 226);
    --aw-color-secondary: rgb(218 139 112);
    --aw-color-accent: rgb(137 177 226);

    --aw-color-text-heading: rgb(245 241 232);
    --aw-color-text-default: rgb(226 222 214);
    --aw-color-text-muted: rgb(168 163 153);
    --aw-color-bg-page: rgb(24 25 26);

    ::selection {
      background-color: rgb(69 88 113);
      color: rgb(255 255 255);
    }
  }
</style>
