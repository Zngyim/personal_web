---
import type { NewsItem } from '~/data/academic-profile';
interface Props {
  items: NewsItem[];
}
const { items } = Astro.props;
---

<ol class="news-list">
  {
    items.map((item) => (
      <li class:list={{ 'news-undated': !item.date }}>
        {item.date && <time datetime={item.dateTime}>{item.date}</time>}
        <p>
          {item.text}
          {item.href && (
            <>
              {' '}
              <a href={item.href}>
                {item.linkLabel || 'Read more'} <span aria-hidden="true">↗</span>
              </a>
            </>
          )}
        </p>
      </li>
    ))
  }
</ol>

<style>
  a {
    white-space: nowrap;
  }
  .news-undated p {
    grid-column: 2;
  }
  @media (max-width: 520px) {
    .news-undated p {
      grid-column: 1;
    }
  }
</style>
