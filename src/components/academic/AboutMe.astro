---
import { Icon } from 'astro-icon/components';
import { profile } from '~/data/academic-profile';
---

<section id="about" class="profile-hero" aria-labelledby="about-heading">
  <div class="portrait-column">
    {
      profile.portrait ? (
        <img class="portrait-image" src={profile.portrait} alt={profile.portraitAlt} width="1024" height="1440" />
      ) : (
        <div class="portrait-placeholder" role="img" aria-label="Portrait placeholder">
          <>
            <span aria-hidden="true">{profile.name.slice(0, 1)}</span>
            <small>Portrait</small>
          </>
        </div>
      )
    }
  </div>
  <div class="profile-copy">
    <h1 id="profile-name">{profile.name}{profile.nativeName && <span>{profile.nativeName}</span>}</h1>
    {
      (profile.role || profile.affiliation) && (
        <p class="profile-role">
          {profile.role}
          {profile.role && profile.affiliation && <span aria-hidden="true"> · </span>}
          {profile.affiliation}
        </p>
      )
    }
    <h2 id="about-heading" class="about-heading">About Me</h2>
    <div class="profile-introduction">
      {
        profile.introduction.length > 0 || profile.researchStatement ? (
          <>
            {profile.introduction.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {profile.researchStatement && <p>{profile.researchStatement}</p>}
          </>
        ) : (
          <p class="academic-empty">Biography and research interests coming soon.</p>
        )
      }
    </div>
    {
      profile.interests.length > 0 && (
        <ul class="interest-list" aria-label="Research interests">
          {profile.interests.map((interest) => (
            <li>{interest}</li>
          ))}
        </ul>
      )
    }
    {profile.location && <p class="profile-location">Based in {profile.location}</p>}
    {
      profile.links.length > 0 && (
        <nav class="profile-links" aria-label="Contact links and CV">
          <ul>
            {profile.links.map((link, index) => (
              <li class="profile-link-item">
                {link.href ? (
                  <a
                    class="profile-contact"
                    href={link.href}
                    title={link.href.startsWith('mailto:') ? link.href.slice(7) : undefined}
                    target={link.href.startsWith('http') || link.href.endsWith('.pdf') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') || link.href.endsWith('.pdf') ? 'noreferrer' : undefined}
                  >
                    <Icon name={link.icon} aria-hidden="true" />
                    <span>{link.label}</span>
                  </a>
                ) : link.value ? (
                  <div class="contact-disclosure" data-contact-disclosure>
                    <button
                      type="button"
                      class="profile-contact contact-trigger"
                      aria-expanded="false"
                      aria-controls={`contact-value-${index}`}
                      aria-describedby={`contact-value-${index}`}
                    >
                      <Icon name={link.icon} aria-hidden="true" />
                      <span>{link.label}</span>
                    </button>
                    <div id={`contact-value-${index}`} class="contact-popover" role="tooltip" hidden>
                      <div class="contact-popover-card">
                        <span class="contact-popover-label">{link.label} ID</span>
                        <span class="contact-popover-value">{link.value}</span>
                      </div>
                    </div>
                  </div>
                ) : (
                  <span class="profile-contact profile-contact-pending" title={`${link.label} link coming soon`}>
                    <Icon name={link.icon} aria-hidden="true" />
                    <span>{link.label}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</section>

<script>
  let contactListeners: AbortController | undefined;

  const initializeContacts = () => {
    contactListeners?.abort();
    contactListeners = new AbortController();
    const options = { signal: contactListeners.signal };

    document.querySelectorAll<HTMLElement>('[data-contact-disclosure]').forEach((container) => {
      const trigger = container.querySelector<HTMLButtonElement>('button');
      const popover = container.querySelector<HTMLElement>('[role="tooltip"]');
      if (!trigger || !popover) return;

      let pinned = false;
      const setOpen = (open: boolean) => {
        trigger.setAttribute('aria-expanded', String(open));
        popover.hidden = !open;
      };
      const close = () => {
        pinned = false;
        setOpen(false);
      };

      container.addEventListener(
        'pointerenter',
        (event) => {
          if (event.pointerType === 'mouse') setOpen(true);
        },
        options
      );
      container.addEventListener(
        'pointerleave',
        () => {
          if (!pinned && !container.contains(document.activeElement)) setOpen(false);
        },
        options
      );
      trigger.addEventListener('focus', () => setOpen(true), options);
      trigger.addEventListener(
        'click',
        () => {
          pinned = !pinned;
          setOpen(pinned);
        },
        options
      );
      container.addEventListener(
        'focusout',
        (event) => {
          if (!(event.relatedTarget instanceof Node) || !container.contains(event.relatedTarget)) close();
        },
        options
      );
      document.addEventListener(
        'pointerdown',
        (event) => {
          if (event.target instanceof Node && !container.contains(event.target)) close();
        },
        options
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') close();
        },
        options
      );
    });
  };

  initializeContacts();
  document.addEventListener('astro:page-load', initializeContacts);
  document.addEventListener('astro:before-swap', () => contactListeners?.abort());
</script>

<style>
  .about-heading {
    margin-top: 1.5rem;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .profile-introduction {
    margin-top: 0.6rem;
  }

  .contact-disclosure {
    position: relative;
    display: inline-flex;
  }
  .contact-trigger {
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .contact-trigger:focus-visible {
    outline: 2px solid var(--aw-color-primary);
    outline-offset: 5px;
    border-radius: 2px;
  }
  .contact-popover {
    position: absolute;
    z-index: 20;
    top: 100%;
    left: 50%;
    padding-top: 0.6rem;
    transform: translateX(-50%);
  }
  .contact-popover-card {
    display: grid;
    gap: 0.3rem;
    min-width: 9rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgb(25 24 20 / 12%);
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 4px 16px rgb(25 24 20 / 9%);
    text-align: left;
    white-space: nowrap;
  }
  .contact-popover-label {
    color: var(--aw-color-text-muted);
    font-size: 0.68rem;
    line-height: 1.3;
  }
  .contact-popover-value {
    color: var(--aw-color-text-default);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.4;
    user-select: all;
  }
</style>
