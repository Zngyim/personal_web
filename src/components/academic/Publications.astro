---
import { Icon } from 'astro-icon/components';
import { profile, publications, type PublicationItem } from '~/data/academic-profile';
interface Props {
  items?: PublicationItem[];
}
const { items = publications } = Astro.props;
---

<section id="publications" class="academic-section" aria-labelledby="publications-heading">
  <header class="section-header"><h2 id="publications-heading">Publications</h2></header>
  {
    items.length > 0 ? (
      <div class="papers">
        {items.map((paper) => {
          const titleLink =
            paper.links?.find((link) => /^(paper|pdf|arxiv)$/i.test(link.label))?.href || paper.links?.[0]?.href;
          const previewLink = paper.links?.find((link) => /^project$/i.test(link.label))?.href || titleLink;
          return (
            <article class:list={['paper', { 'paper-featured': paper.highlighted }]}>
              <div class:list={['paper-preview', { 'paper-preview-empty': !paper.image }]}>
                {paper.image ? (
                  <a href={previewLink} target="_blank" rel="noopener noreferrer">
                    <img
                      src={paper.image}
                      alt={paper.imageAlt || `${paper.title} preview`}
                      loading="lazy"
                      decoding="async"
                      width={paper.imageWidth || 160}
                      height={paper.imageHeight || 120}
                    />
                  </a>
                ) : (
                  <Icon name="tabler:file-text" aria-hidden="true" />
                )}
              </div>
              <div class="paper-copy">
                <h3>
                  {titleLink ? (
                    <a href={titleLink} target="_blank" rel="noopener noreferrer">
                      {paper.title}
                    </a>
                  ) : (
                    paper.title
                  )}
                </h3>
                <p class="paper-authors">
                  {paper.authors.split(',').map((author, index) => {
                    const markers = author.trim().match(/[*†‡]+$/)?.[0] || '';
                    const name = author.trim().slice(0, author.trim().length - markers.length);
                    const note = [...markers]
                      .map((marker) => paper.authorNotes?.[marker])
                      .filter(Boolean)
                      .join('; ');
                    return (
                      <>
                        {index > 0 && ', '}
                        {name === profile.name ? <strong>{name}</strong> : name}
                        {markers && <sup title={note || undefined} aria-label={note || undefined} set:text={markers} />}
                      </>
                    );
                  })}
                </p>
                <p class="paper-venue">
                  <strong>{paper.venue}</strong>
                  <span class="paper-year"> · {paper.year}</span>
                </p>
                {paper.description && <p class="paper-description">{paper.description}</p>}
                {paper.links && paper.links.length > 0 && (
                  <nav class="paper-links" aria-label={`Resources for ${paper.title}`}>
                    {paper.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener noreferrer">
                        {link.label}
                      </a>
                    ))}
                  </nav>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="academic-empty">Selected papers and preprints will appear here.</p>
    )
  }
</section>

<style>
  .paper {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    padding: 1.25rem 0;
  }
  .paper + .paper {
    border-top: 1px solid rgb(25 24 20 / 10%);
  }
  .paper-featured {
    padding-inline: 1rem;
    background: rgb(71 96 79 / 4%);
  }
  .paper-preview {
    overflow: hidden;
    border: 1px solid rgb(25 24 20 / 12%);
    border-radius: 5px;
    background: #fff;
  }
  .paper-preview-empty {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    background: rgb(71 96 79 / 4%);
    color: var(--aw-color-text-muted);
  }
  .paper-preview img {
    display: block;
    width: 100%;
    height: auto;
  }
  .paper-preview a {
    display: block;
  }
  .paper-preview :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.5;
  }
  .paper-copy {
    overflow-wrap: anywhere;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .paper-copy h3 {
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-sans);
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .paper-copy a {
    color: var(--aw-color-primary);
    text-underline-offset: 0.2em;
  }
  .paper-copy a:hover {
    text-decoration: underline;
  }
  .paper-copy h3 a {
    color: inherit;
  }
  .paper-copy h3 a:hover {
    color: var(--aw-color-primary);
    text-decoration: none;
  }
  .paper-authors {
    color: var(--aw-color-text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .paper-authors strong {
    color: var(--aw-color-text-heading);
    font-weight: 600;
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }
  .paper-authors sup {
    position: static;
    font-size: 0.7em;
    line-height: 0;
    vertical-align: super;
  }
  .paper-venue {
    font-size: 0.82rem;
  }
  .paper-venue strong {
    color: var(--aw-color-text-heading);
    font-weight: 600;
  }
  .paper-year {
    color: var(--aw-color-text-muted);
  }
  .paper-authors,
  .paper-venue,
  .paper-description {
    margin-top: 0.35rem;
  }
  .paper-description {
    color: var(--aw-color-text-muted);
  }
  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.65rem;
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .paper-links a {
    padding: 0.2rem 0.6rem;
    border: 1px solid rgb(25 24 20 / 17%);
    border-radius: 3px;
    color: var(--aw-color-text-muted);
    background: #fff;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .paper-links a:hover,
  .paper-links a:focus-visible {
    border-color: var(--aw-color-primary);
    color: var(--aw-color-primary);
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .paper {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
