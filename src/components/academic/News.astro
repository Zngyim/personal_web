---
import { news, type NewsItem } from '~/data/academic-profile';
import NewsList from './NewsList.astro';
interface Props {
  items?: NewsItem[];
}
const { items = news } = Astro.props;
const recent = items.slice(0, 5);
const earlier = items.slice(5);
---

<section id="news" class="academic-section" aria-labelledby="news-heading">
  <header class="section-header"><h2 id="news-heading">News</h2></header>
  {
    items.length > 0 ? (
      <>
        <NewsList items={recent} />
        {earlier.length > 0 && (
          <details class="earlier-news">
            <summary>Earlier updates ({earlier.length})</summary>
            <NewsList items={earlier} />
          </details>
        )}
      </>
    ) : (
      <p class="academic-empty">Updates, talks, and milestones will appear here.</p>
    )
  }
</section>

<style>
  .earlier-news {
    margin-top: 1rem;
  }
  .earlier-news summary {
    width: fit-content;
    color: var(--aw-color-primary);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .earlier-news[open] summary {
    margin-bottom: 0.5rem;
  }
</style>
