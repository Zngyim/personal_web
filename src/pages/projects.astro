---
import Layout from '~/layouts/PageLayout.astro';
import { projects } from '~/data/projects';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Projects',
  description: 'Interactive research, simulation, and visualization projects by Yiming.',
};
---

<Layout metadata={metadata}>
  <div class="academic-main">
    <div class="academic-shell academic-subpage">
      <header class="academic-subpage-header academic-reveal">
        <p class="academic-kicker">Project archive</p>
        <h1>Projects</h1>
        <p>Interactive work spanning control systems, nonlinear dynamics, and guidance simulation.</p>
        <a class="academic-back-link" href="/#projects">← Return to the homepage</a>
      </header>

      <section class="academic-section" aria-labelledby="project-list-heading">
        <header class="section-header">
          <p>01</p>
          <h2 id="project-list-heading">All projects</h2>
        </header>

        <div class="project-list">
          {
            projects.map((project, index) => (
              <article class="project-row">
                <a
                  class="project-cover"
                  href={getPermalink(`/projects/${project.slug}`)}
                  aria-label={`Open ${project.title}`}
                >
                  <img
                    src={project.cover}
                    alt={project.coverAlt}
                    width="640"
                    height="400"
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </a>
                <div class="project-copy">
                  <p class="project-eyebrow">{project.eyebrow}</p>
                  <h3>
                    <a href={getPermalink(`/projects/${project.slug}`)}>{project.title}</a>
                  </h3>
                  <p>{project.description}</p>
                  <a class="project-link" href={getPermalink(`/projects/${project.slug}`)}>
                    Launch project <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
