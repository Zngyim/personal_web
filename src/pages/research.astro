---
import Layout from '~/layouts/PageLayout.astro';
import { profile, publications } from '~/data/academic-profile';

const metadata = {
  title: 'Research',
  description: `Research interests and publications by ${profile.name}.`,
};
---

<Layout metadata={metadata}>
  <div class="academic-main">
    <div class="academic-shell academic-subpage">
      <header class="academic-subpage-header academic-reveal">
        <p class="academic-kicker">Research archive</p>
        <h1>Research</h1>
        <p>{profile.researchStatement}</p>
        <a class="academic-back-link" href="/#research">← Return to the homepage</a>
      </header>

      <section class="academic-section" aria-labelledby="publications-heading">
        <header class="section-header">
          <p>01</p>
          <h2 id="publications-heading">Publications</h2>
        </header>

        {
          publications.length > 0 ? (
            <ol class="research-archive-list">
              {publications.map((publication) => (
                <li>
                  <time>{publication.year}</time>
                  <div>
                    <h3>{publication.title}</h3>
                    <p>{publication.authors}</p>
                    <p>
                      <em>{publication.venue}</em>
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="academic-empty">Publications and preprints will be listed here when available.</p>
          )
        }
      </section>
    </div>
  </div>
</Layout>
