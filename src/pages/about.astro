---
import Layout from '~/layouts/PageLayout.astro';
import { appointments, education, profile } from '~/data/academic-profile';

const metadata = {
  title: 'About',
  description: `Biography and academic background of ${profile.name}.`,
};
---

<Layout metadata={metadata}>
  <div class="academic-main">
    <div class="academic-shell academic-subpage">
      <header class="academic-subpage-header academic-reveal">
        <p class="academic-kicker">Biography</p>
        <h1>About {profile.name}</h1>
        <div class="academic-subpage-copy">
          {profile.introduction.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a class="academic-back-link" href="/#about">← Return to the homepage</a>
      </header>

      <section class="academic-section" aria-labelledby="background-heading">
        <header class="section-header">
          <p>01</p>
          <h2 id="background-heading">Background</h2>
        </header>
        {
          appointments.length + education.length === 0 ? (
            <p class="academic-empty">A full biography, appointments, and education will be added here.</p>
          ) : (
            <div class="background-grid">
              {appointments.length > 0 && (
                <div>
                  <h3>Appointments</h3>
                  <ol class="timeline-list">
                    {appointments.map((item) => (
                      <li>
                        <time>{item.period}</time>
                        <div>
                          <strong>{item.title}</strong>
                          {item.organization && <p>{item.organization}</p>}
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
              {education.length > 0 && (
                <div>
                  <h3>Education</h3>
                  <ol class="timeline-list">
                    {education.map((item) => (
                      <li>
                        <time>{item.period}</time>
                        <div>
                          <strong>{item.title}</strong>
                          {item.organization && <p>{item.organization}</p>}
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          )
        }
      </section>
    </div>
  </div>
</Layout>
