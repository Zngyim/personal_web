---
import Layout from '~/layouts/PageLayout.astro';
import { profile } from '~/data/academic-profile';
import AboutMe from '~/components/academic/AboutMe.astro';
import News from '~/components/academic/News.astro';
import Publications from '~/components/academic/Publications.astro';
import Honors from '~/components/academic/Honors.astro';
import Experience from '~/components/academic/Experience.astro';
import OutsideResearch from '~/components/academic/OutsideResearch.astro';

const metadata = {
  title: `${profile.name} — Academic Homepage`,
  description: `Academic homepage of ${profile.name}: research, publications, honors, and experience.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="academic-main">
    <div class="academic-shell">
      <AboutMe />
      <News />
      <Publications />
      <Honors />
      <Experience />
      <OutsideResearch />
    </div>
  </div>
</Layout>
